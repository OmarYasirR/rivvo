# Server
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/rivvo
JWT_SECRET=change_this_secret
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:5173

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Image uploads: auto | local | cloudinary
#   auto       = Cloudinary when keys are set; if Cloudinary fails (e.g. 403) or has no keys, save to local disk
#   local      = always save to server/uploads
#   cloudinary = Cloudinary only (errors instead of falling back)
UPLOAD_DRIVER=auto
# auto mode: seconds Cloudinary gets before falling back, and minutes to skip it after a failure
# CLOUDINARY_TIMEOUT_MS=8000
# CLOUDINARY_RETRY_MINUTES=10
# Only if the client is served from a different origin than the API in production, e.g. https://api.example.com
PUBLIC_URL=

# Email (password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Rivvo <no-reply@rivvo.app>

# Client (Vite)
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
